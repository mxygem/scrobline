# Copy to .env and adjust. .env is gitignored; never commit real credentials.
POSTGRES_USER=scrobble
POSTGRES_PASSWORD=scrobble
POSTGRES_DB=scrobble
POSTGRES_PORT=5432

# Consumed by the Go services once they exist:
DATABASE_URL=postgres://scrobble:scrobble@localhost:5432/scrobble?sslmode=disable
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
